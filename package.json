{
  "name": "securepool",
"version": "1.0.0",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "start:backend": "cd apps/demo-backend && npx ts-node src/index.ts",
    "start:frontend": "cd apps/demo-frontend && npx vite"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
